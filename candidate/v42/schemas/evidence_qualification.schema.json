{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "zervan://candidate/v42/schemas/evidence_qualification.schema.json",
  "title": "Zervan candidate v42 evidence_qualification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "record_id",
    "object_id",
    "return_record_id",
    "claim_id",
    "evidence_class",
    "independence_status",
    "contamination_status",
    "disposition",
    "authority_state",
    "human_gate_state",
    "canonical"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "record_type": {
      "type": "string",
      "const": "evidence_qualification"
    },
    "record_id": {
      "type": "string",
      "pattern": "^sha512:[0-9a-f]{128}$"
    },
    "authority_state": {
      "type": "string",
      "const": "NONE"
    },
    "human_gate_state": {
      "type": "string",
      "const": "ACTIVE"
    },
    "canonical": {
      "type": "boolean",
      "const": false
    },
    "object_id": {
      "type": [
        "string",
        "object",
        "array",
        "boolean",
        "integer"
      ],
      "minLength": 1
    },
    "return_record_id": {
      "type": [
        "string",
        "object",
        "array",
        "boolean",
        "integer"
      ],
      "minLength": 1
    },
    "claim_id": {
      "type": [
        "string",
        "object",
        "array",
        "boolean",
        "integer"
      ],
      "minLength": 1
    },
    "evidence_class": {
      "type": "string",
      "enum": [
        "OBSERVATION",
        "INFERENCE",
        "SYNTHETIC",
        "SIMULATED",
        "REPRODUCED",
        "CONTRADICTION",
        "NON_FINDING",
        "CONTROL_FAILURE",
        "CONTAMINATED",
        "UNKNOWN"
      ]
    },
    "independence_status": {
      "type": "string",
      "enum": [
        "QUALIFIED",
        "DEPENDENT",
        "UNKNOWN"
      ]
    },
    "contamination_status": {
      "type": "string",
      "enum": [
        "CLEAN",
        "CONTAMINATED",
        "UNKNOWN"
      ]
    },
    "disposition": {
      "type": [
        "string",
        "object",
        "array",
        "boolean",
        "integer"
      ],
      "minLength": 1
    }
  }
}
