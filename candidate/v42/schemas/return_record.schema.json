{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "zervan://candidate/v42/schemas/return_record.schema.json",
  "title": "Zervan candidate v42 return_record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "record_id",
    "object_id",
    "execution_id",
    "starting_coordinate",
    "returned_object_id",
    "object_continuity",
    "reconstruction_required",
    "result_status",
    "authority_state",
    "human_gate_state",
    "canonical"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "record_type": {
      "type": "string",
      "const": "return_record"
    },
    "record_id": {
      "type": "string",
      "pattern": "^sha512:[0-9a-f]{128}$"
    },
    "authority_state": {
      "type": "string",
      "const": "NONE"
    },
    "human_gate_state": {
      "type": "string",
      "const": "ACTIVE"
    },
    "canonical": {
      "type": "boolean",
      "const": false
    },
    "object_id": {
      "type": [
        "string",
        "object",
        "array",
        "boolean",
        "integer"
      ],
      "minLength": 1
    },
    "execution_id": {
      "type": [
        "string",
        "object",
        "array",
        "boolean",
        "integer"
      ],
      "minLength": 1
    },
    "starting_coordinate": {
      "type": [
        "string",
        "object",
        "array",
        "boolean",
        "integer"
      ],
      "minLength": 1
    },
    "returned_object_id": {
      "type": [
        "string",
        "object",
        "array",
        "boolean",
        "integer"
      ],
      "minLength": 1
    },
    "object_continuity": {
      "type": "string",
      "enum": [
        "PRESERVED",
        "BROKEN",
        "UNKNOWN"
      ]
    },
    "reconstruction_required": {
      "type": "boolean"
    },
    "result_status": {
      "type": "string",
      "enum": [
        "UNQUALIFIED",
        "QUALIFIED",
        "NON_FINDING",
        "CONTAMINATED",
        "UNKNOWN"
      ]
    }
  }
}
