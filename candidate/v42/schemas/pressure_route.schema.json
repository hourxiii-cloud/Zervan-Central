{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "zervan://candidate/v42/schemas/pressure_route.schema.json",
  "title": "Zervan candidate v42 pressure_route",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "record_id",
    "object_id",
    "trigger_evaluation_id",
    "mission_question",
    "required_work",
    "selected_force",
    "rejected_stronger_force",
    "disposition",
    "authority_state",
    "human_gate_state",
    "canonical"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "record_type": {
      "type": "string",
      "const": "pressure_route"
    },
    "record_id": {
      "type": "string",
      "pattern": "^sha512:[0-9a-f]{128}$"
    },
    "authority_state": {
      "type": "string",
      "const": "NONE"
    },
    "human_gate_state": {
      "type": "string",
      "const": "ACTIVE"
    },
    "canonical": {
      "type": "boolean",
      "const": false
    },
    "object_id": {
      "type": [
        "string",
        "object",
        "array",
        "boolean",
        "integer"
      ],
      "minLength": 1
    },
    "trigger_evaluation_id": {
      "type": [
        "string",
        "object",
        "array",
        "boolean",
        "integer"
      ],
      "minLength": 1
    },
    "mission_question": {
      "type": [
        "string",
        "object",
        "array",
        "boolean",
        "integer"
      ],
      "minLength": 1
    },
    "required_work": {
      "type": "array"
    },
    "selected_force": {
      "type": "string",
      "enum": [
        "NON_MOTION",
        "OBSERVATION",
        "BOUNDED_PROBE",
        "SPECIALIST",
        "MULTI_CAPABILITY_SET",
        "SQUAD",
        "PLATOON",
        "ANIMALKINGDOM",
        "NO_ADMISSIBLE_ROUTE"
      ]
    },
    "rejected_stronger_force": {
      "type": "array"
    },
    "disposition": {
      "type": [
        "string",
        "object",
        "array",
        "boolean",
        "integer"
      ],
      "minLength": 1
    }
  }
}
