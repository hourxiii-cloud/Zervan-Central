{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "zervan://candidate/v42/schemas/trigger_evaluation.schema.json",
  "title": "Zervan candidate v42 trigger_evaluation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "record_id",
    "object_id",
    "coordinate",
    "initiation_class",
    "question",
    "evidence_refs",
    "expected_discriminating_value",
    "disposition",
    "authority_state",
    "human_gate_state",
    "canonical"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "record_type": {
      "type": "string",
      "const": "trigger_evaluation"
    },
    "record_id": {
      "type": "string",
      "pattern": "^sha512:[0-9a-f]{128}$"
    },
    "authority_state": {
      "type": "string",
      "const": "NONE"
    },
    "human_gate_state": {
      "type": "string",
      "const": "ACTIVE"
    },
    "canonical": {
      "type": "boolean",
      "const": false
    },
    "object_id": {
      "type": [
        "string",
        "object",
        "array",
        "boolean",
        "integer"
      ],
      "minLength": 1
    },
    "coordinate": {
      "type": [
        "string",
        "object",
        "array",
        "boolean",
        "integer"
      ],
      "minLength": 1
    },
    "initiation_class": {
      "type": "string",
      "enum": [
        "HUMAN_DIRECTED",
        "ZERVAN_ENDOGENOUS_CANDIDATE",
        "SYSTEM_CONTROL_REQUIRED",
        "UNKNOWN_SOURCE"
      ]
    },
    "question": {
      "type": [
        "string",
        "object",
        "array",
        "boolean",
        "integer"
      ],
      "minLength": 1
    },
    "evidence_refs": {
      "type": "array"
    },
    "expected_discriminating_value": {
      "type": [
        "string",
        "object",
        "array",
        "boolean",
        "integer"
      ],
      "minLength": 1
    },
    "disposition": {
      "type": [
        "string",
        "object",
        "array",
        "boolean",
        "integer"
      ],
      "minLength": 1
    }
  }
}
