{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "zervan://schemas/integrity/historical_fidelity_proof.schema.json",
  "title": "Zervan AC-08 Historical Fidelity Proof",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "proof_id",
    "object_id",
    "historical_room_revision_id",
    "historical_state_root",
    "historical_coordinate",
    "historical_question_reference",
    "historical_inquiry_envelope_reference",
    "historical_evidence_used_references",
    "historical_evidence_boundary_reference",
    "historical_evidence_ceiling_reference",
    "historical_provenance_route",
    "historical_lineage_edges",
    "historical_collapse_references",
    "historical_eliminated_alternatives",
    "historical_retained_alternatives",
    "historical_deferred_alternatives",
    "historical_finding_references",
    "historical_rendering_reference",
    "historical_cartography_reference",
    "historical_stick_reference",
    "proof_witnesses",
    "proof_disposition",
    "blocking_reasons",
    "provenance_route",
    "authority_state",
    "human_gate_state"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "proof_id": {
      "type": "string",
      "minLength": 1
    },
    "object_id": {
      "type": "string",
      "pattern": "^sha512:[0-9a-f]{128}$"
    },
    "historical_room_revision_id": {
      "type": "string",
      "minLength": 1
    },
    "historical_state_root": {
      "type": "string",
      "pattern": "^sha512:[0-9a-f]{128}$"
    },
    "historical_coordinate": {
      "type": "string",
      "minLength": 1
    },
    "historical_question_reference": {
      "type": "string",
      "minLength": 1
    },
    "historical_inquiry_envelope_reference": {
      "type": "string",
      "minLength": 1
    },
    "historical_evidence_used_references": {
      "$ref": "#/$defs/nonempty_string_array"
    },
    "historical_evidence_boundary_reference": {
      "type": "string",
      "minLength": 1
    },
    "historical_evidence_ceiling_reference": {
      "type": "string",
      "minLength": 1
    },
    "historical_provenance_route": {
      "$ref": "#/$defs/nonempty_string_array"
    },
    "historical_lineage_edges": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "parent_reference",
          "child_reference",
          "historical_state_root",
          "sequence"
        ],
        "properties": {
          "parent_reference": {
            "type": "string",
            "minLength": 1
          },
          "child_reference": {
            "type": "string",
            "minLength": 1
          },
          "historical_state_root": {
            "type": "string",
            "pattern": "^sha512:[0-9a-f]{128}$"
          },
          "sequence": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "historical_collapse_references": {
      "$ref": "#/$defs/string_array"
    },
    "historical_eliminated_alternatives": {
      "$ref": "#/$defs/string_array"
    },
    "historical_retained_alternatives": {
      "$ref": "#/$defs/string_array"
    },
    "historical_deferred_alternatives": {
      "$ref": "#/$defs/string_array"
    },
    "historical_finding_references": {
      "$ref": "#/$defs/string_array"
    },
    "historical_rendering_reference": {
      "type": ["string", "null"]
    },
    "historical_cartography_reference": {
      "type": "string",
      "minLength": 1
    },
    "historical_stick_reference": {
      "type": "string",
      "minLength": 1
    },
    "proof_witnesses": {
      "$ref": "#/$defs/nonempty_string_array"
    },
    "proof_disposition": {
      "enum": ["PROVEN", "BLOCKED"]
    },
    "blocking_reasons": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "HISTORICAL_STATE_ROOT_MISSING",
          "CURRENT_ONLY_RESOLUTION",
          "HISTORICAL_EXISTENCE_UNPROVEN",
          "PROVENANCE_GRAFT",
          "PROVENANCE_TRUNCATED",
          "PROVENANCE_TEMPORAL_REORDER",
          "PROVENANCE_CHAIN_FALSE",
          "CURRENT_EVIDENCE_REBOUND",
          "CURRENT_QUESTION_SUBSTITUTED",
          "LATER_EVIDENCE_STRENGTHENED_HISTORY",
          "REPLAY_REFLIGHT_EVIDENCE_MIXED",
          "COLLAPSE_HISTORY_MUTATED",
          "ELIMINATED_ALTERNATIVES_LOST",
          "REGENERATED_RENDERING_IMPERSONATES_HISTORICAL",
          "PROOF_WITNESS_MISSING",
          "PROVENANCE_MISSING"
        ]
      }
    },
    "provenance_route": {
      "$ref": "#/$defs/nonempty_string_array"
    },
    "authority_state": {
      "const": "NONE"
    },
    "human_gate_state": {
      "const": "ACTIVE"
    }
  },
  "$defs": {
    "string_array": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "nonempty_string_array": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
