{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "zervan://schemas/runtime/scar_record.schema.json",
  "title": "Zervan R4-G Scar Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scar_record_id",
    "object_id",
    "terrain_reference",
    "affected_movement_references",
    "effect_evidence_references",
    "effect_description",
    "observational_coordinate",
    "question_contract_reference",
    "inquiry_envelope_reference",
    "occupied_zone_reference",
    "occupied_space_reference",
    "transform_references",
    "capability_route_references",
    "restriction_constriction_references",
    "collapse_boundary_references",
    "finding_references",
    "evidence_boundary",
    "evidence_ceiling",
    "cartography_reference",
    "stick_reference",
    "replay_envelope_reference",
    "effect_persistence",
    "unresolved_implications",
    "provenance_route",
    "governance_reference",
    "authorization_reference",
    "human_gate_reference",
    "recorded_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "scar_record_id": {
      "type": "string",
      "pattern": "^sha512:[0-9a-f]{128}$"
    },
    "object_id": {
      "type": "string",
      "pattern": "^sha512:[0-9a-f]{128}$"
    },
    "terrain_reference": {
      "type": "string",
      "minLength": 1
    },
    "affected_movement_references": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "effect_evidence_references": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "effect_description": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "observational_coordinate": {
      "type": [
        "string",
        "object"
      ]
    },
    "question_contract_reference": {
      "type": [
        "string",
        "null"
      ]
    },
    "inquiry_envelope_reference": {
      "type": [
        "string",
        "null"
      ]
    },
    "occupied_zone_reference": {
      "type": "string",
      "minLength": 1
    },
    "occupied_space_reference": {
      "type": "string",
      "minLength": 1
    },
    "transform_references": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "capability_route_references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "restriction_constriction_references": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "collapse_boundary_references": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "finding_references": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence_boundary": {
      "type": [
        "string",
        "object"
      ]
    },
    "evidence_ceiling": {
      "type": [
        "string",
        "object"
      ]
    },
    "cartography_reference": {
      "type": "string",
      "minLength": 1
    },
    "stick_reference": {
      "type": "string",
      "minLength": 1
    },
    "replay_envelope_reference": {
      "type": [
        "string",
        "null"
      ]
    },
    "effect_persistence": {
      "type": "string",
      "enum": [
        "ACTIVE",
        "HISTORICAL",
        "UNRESOLVED"
      ]
    },
    "unresolved_implications": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "provenance_route": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "governance_reference": {
      "type": "string",
      "minLength": 1
    },
    "authorization_reference": {
      "type": [
        "string",
        "null"
      ]
    },
    "human_gate_reference": {
      "type": [
        "string",
        "null"
      ]
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
