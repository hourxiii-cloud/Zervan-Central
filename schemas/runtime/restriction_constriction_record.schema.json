{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "zervan://schemas/runtime/restriction_constriction_record.schema.json",
  "title": "Zervan R4-A Restriction / Constriction Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "restriction_constriction_id",
    "object_id",
    "operation_type",
    "active_question",
    "mission_reference",
    "representation_reference",
    "prior_operation_reference",
    "evidence_references",
    "further_evidence_references",
    "pre_supported_states",
    "post_supported_states",
    "removed_from_support_states",
    "unresolved_states",
    "operation_basis",
    "evidence_boundary",
    "evidence_ceiling",
    "provenance_anchors",
    "representation_history_references",
    "cartography_reference",
    "stick_reference",
    "return_state_reference",
    "governance_reference",
    "authorization_reference",
    "human_gate_reference",
    "provenance_route",
    "operated_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "restriction_constriction_id": {
      "type": "string",
      "pattern": "^sha512:[0-9a-f]{128}$"
    },
    "object_id": {
      "type": "string",
      "pattern": "^sha512:[0-9a-f]{128}$"
    },
    "operation_type": {
      "type": "string",
      "enum": [
        "RESTRICTION",
        "CONSTRICTION"
      ]
    },
    "active_question": {
      "type": "string",
      "minLength": 1
    },
    "mission_reference": {
      "type": "string",
      "minLength": 1
    },
    "representation_reference": {
      "type": "string",
      "minLength": 1
    },
    "prior_operation_reference": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence_references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "further_evidence_references": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "pre_supported_states": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "post_supported_states": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "removed_from_support_states": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "unresolved_states": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "operation_basis": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence_boundary": {
      "type": [
        "string",
        "object"
      ]
    },
    "evidence_ceiling": {
      "type": [
        "string",
        "object"
      ]
    },
    "provenance_anchors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "representation_history_references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "cartography_reference": {
      "type": "string",
      "minLength": 1
    },
    "stick_reference": {
      "type": "string",
      "minLength": 1
    },
    "return_state_reference": {
      "type": "string",
      "minLength": 1
    },
    "governance_reference": {
      "type": "string",
      "minLength": 1
    },
    "authorization_reference": {
      "type": "string",
      "minLength": 1
    },
    "human_gate_reference": {
      "type": [
        "string",
        "null"
      ]
    },
    "provenance_route": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "operated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
