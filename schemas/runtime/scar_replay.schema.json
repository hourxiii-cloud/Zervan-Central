{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "zervan://schemas/runtime/scar_replay.schema.json",
  "title": "Zervan R4-H Scar Replay",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scar_replay_id",
    "object_id",
    "scar_record_reference",
    "replay_envelope_reference",
    "observer_reference",
    "requested_action",
    "action_basis",
    "historical_observational_coordinate",
    "historical_question_contract_reference",
    "historical_zone_reference",
    "historical_space_reference",
    "historical_transform_references",
    "prior_movement_references",
    "scar_effect_evidence_references",
    "recorded_effect_references",
    "evidence_boundary",
    "evidence_ceiling",
    "cartography_reference",
    "stick_reference",
    "reflight_trigger_reference",
    "branch_control_reference",
    "challenge_evidence_references",
    "ignore_evidence_references",
    "action_eligibility",
    "blocking_reasons",
    "governance_reference",
    "authorization_reference",
    "human_gate_reference",
    "provenance_route",
    "requested_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "scar_replay_id": {
      "type": "string",
      "pattern": "^sha512:[0-9a-f]{128}$"
    },
    "object_id": {
      "type": "string",
      "pattern": "^sha512:[0-9a-f]{128}$"
    },
    "scar_record_reference": {
      "type": "string",
      "minLength": 1
    },
    "replay_envelope_reference": {
      "type": [
        "string",
        "null"
      ]
    },
    "observer_reference": {
      "type": "string",
      "minLength": 1
    },
    "requested_action": {
      "type": "string",
      "enum": [
        "REPLAY",
        "SUMMARIZE",
        "CONTINUE",
        "BRANCH",
        "CHALLENGE",
        "IGNORE_WITH_EVIDENCE"
      ]
    },
    "action_basis": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "historical_observational_coordinate": {
      "type": [
        "string",
        "object"
      ]
    },
    "historical_question_contract_reference": {
      "type": "string",
      "minLength": 1
    },
    "historical_zone_reference": {
      "type": "string",
      "minLength": 1
    },
    "historical_space_reference": {
      "type": "string",
      "minLength": 1
    },
    "historical_transform_references": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "prior_movement_references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "scar_effect_evidence_references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "recorded_effect_references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence_boundary": {
      "type": [
        "string",
        "object"
      ]
    },
    "evidence_ceiling": {
      "type": [
        "string",
        "object"
      ]
    },
    "cartography_reference": {
      "type": "string",
      "minLength": 1
    },
    "stick_reference": {
      "type": "string",
      "minLength": 1
    },
    "reflight_trigger_reference": {
      "type": [
        "string",
        "null"
      ]
    },
    "branch_control_reference": {
      "type": [
        "string",
        "null"
      ]
    },
    "challenge_evidence_references": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "ignore_evidence_references": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "action_eligibility": {
      "type": "string",
      "enum": [
        "ELIGIBLE",
        "BLOCKED"
      ]
    },
    "blocking_reasons": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "governance_reference": {
      "type": "string",
      "minLength": 1
    },
    "authorization_reference": {
      "type": [
        "string",
        "null"
      ]
    },
    "human_gate_reference": {
      "type": [
        "string",
        "null"
      ]
    },
    "provenance_route": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "requested_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
