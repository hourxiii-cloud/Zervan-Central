{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "zervan://schemas/lineage/branch_record.schema.json",
  "title": "Zervan R1-F Branch Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "parent_manifest_reference",
    "parent_state_root",
    "branch_id",
    "branch_reason",
    "branch_nonce",
    "created_at",
    "authorization_reference",
    "provenance_route"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "parent_manifest_reference": {
      "type": "string",
      "minLength": 1
    },
    "parent_state_root": {
      "type": "string",
      "pattern": "^sha512:[0-9a-f]{128}$"
    },
    "branch_id": {
      "type": "string",
      "pattern": "^sha512:[0-9a-f]{128}$"
    },
    "branch_reason": {
      "type": "string",
      "minLength": 1
    },
    "branch_nonce": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "authorization_reference": {
      "type": "string",
      "minLength": 1
    },
    "provenance_route": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
