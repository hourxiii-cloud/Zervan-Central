{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "zervan://schemas/lineage/merge_record.schema.json",
  "title": "Zervan R1-F Merge Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "left_lineage_reference",
    "right_lineage_reference",
    "left_manifest_reference",
    "right_manifest_reference",
    "left_state_root",
    "right_state_root",
    "common_ancestry_reference",
    "merge_id",
    "merge_rationale",
    "merge_nonce",
    "conflicts",
    "unresolved_differences",
    "authorization_reference",
    "provenance_route",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "left_lineage_reference": {
      "type": "string",
      "minLength": 1
    },
    "right_lineage_reference": {
      "type": "string",
      "minLength": 1
    },
    "left_manifest_reference": {
      "type": "string",
      "minLength": 1
    },
    "right_manifest_reference": {
      "type": "string",
      "minLength": 1
    },
    "left_state_root": {
      "type": "string",
      "pattern": "^sha512:[0-9a-f]{128}$"
    },
    "right_state_root": {
      "type": "string",
      "pattern": "^sha512:[0-9a-f]{128}$"
    },
    "common_ancestry_reference": {
      "type": [
        "string",
        "null"
      ]
    },
    "merge_id": {
      "type": "string",
      "pattern": "^sha512:[0-9a-f]{128}$"
    },
    "merge_rationale": {
      "type": "string",
      "minLength": 1
    },
    "merge_nonce": {
      "type": "string",
      "minLength": 1
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unresolved_differences": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "authorization_reference": {
      "type": "string",
      "minLength": 1
    },
    "provenance_route": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
