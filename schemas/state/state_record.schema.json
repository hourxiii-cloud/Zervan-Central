{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "zervan://schemas/state/state_record.schema.json",
  "title": "Zervan R1-E Canonical State Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_reference",
    "state_sequence",
    "state_payload",
    "provenance_route",
    "created_at",
    "state_root"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "manifest_reference": {
      "type": "string",
      "minLength": 1
    },
    "state_sequence": {
      "type": "integer",
      "minimum": 0
    },
    "state_payload": {
      "type": "object"
    },
    "provenance_route": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "state_root": {
      "type": "string",
      "pattern": "^sha512:[0-9a-f]{128}$"
    }
  }
}
