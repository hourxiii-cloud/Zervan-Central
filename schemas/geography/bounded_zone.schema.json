{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "zervan://schemas/geography/bounded_zone.schema.json",
  "title": "Zervan R2-D Bounded Zone",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "object_id",
    "zone_id",
    "transform_type",
    "perspective_owner_or_discipline",
    "included_evidence",
    "excluded_evidence",
    "time_frame",
    "evidence_ceiling",
    "prohibited_assumptions",
    "provenance_route",
    "return_coordinates"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "object_id": {
      "type": "string",
      "pattern": "^sha512:[0-9a-f]{128}$"
    },
    "zone_id": {
      "type": "string",
      "pattern": "^sha512:[0-9a-f]{128}$"
    },
    "transform_type": {
      "type": "string",
      "minLength": 1
    },
    "perspective_owner_or_discipline": {
      "type": "string",
      "minLength": 1
    },
    "included_evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "excluded_evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "time_frame": {
      "type": [
        "string",
        "object"
      ]
    },
    "evidence_ceiling": {
      "type": [
        "string",
        "object"
      ]
    },
    "prohibited_assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "provenance_route": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "return_coordinates": {
      "type": [
        "string",
        "object"
      ]
    }
  }
}
