{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "zervan://schemas/geography/territory_record.schema.json",
  "title": "Zervan R2-C Territory Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "territory_record_id",
    "object_id",
    "reachable_terrain_references",
    "validated_relationship_references",
    "reachable_surface_references",
    "unresolved_reachability_references",
    "excluded_unreachable_references",
    "provenance_route",
    "derived_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "territory_record_id": {
      "type": "string",
      "pattern": "^sha512:[0-9a-f]{128}$"
    },
    "object_id": {
      "type": "string",
      "pattern": "^sha512:[0-9a-f]{128}$"
    },
    "reachable_terrain_references": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "validated_relationship_references": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "reachable_surface_references": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "unresolved_reachability_references": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "excluded_unreachable_references": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "provenance_route": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "derived_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
