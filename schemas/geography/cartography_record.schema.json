{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "zervan://schemas/geography/cartography_record.schema.json",
  "title": "Zervan R2-H Analytical Cartography Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "cartography_id",
    "object_id",
    "object_topology",
    "room_geometry",
    "zone_references",
    "transform_references",
    "space_references",
    "orientation_references",
    "terrain_references",
    "territory_references",
    "provenance_anchors",
    "evidence_boundaries",
    "evidence_ceilings",
    "stable_regions",
    "uncertainty_frontiers",
    "deformation_regions",
    "invariant_anchors",
    "return_routes",
    "perspective_overlays",
    "evolution_references",
    "capability_position_references",
    "collapse_boundary_references",
    "passageway_references",
    "propagation_vector_references",
    "recorded_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "cartography_id": {
      "type": "string",
      "pattern": "^sha512:[0-9a-f]{128}$"
    },
    "object_id": {
      "type": "string",
      "pattern": "^sha512:[0-9a-f]{128}$"
    },
    "object_topology": {
      "type": [
        "object",
        "array"
      ]
    },
    "room_geometry": {
      "type": [
        "object",
        "array"
      ]
    },
    "zone_references": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "transform_references": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "space_references": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "orientation_references": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "terrain_references": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "territory_references": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "provenance_anchors": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence_boundaries": {
      "type": "array",
      "items": {
        "type": [
          "string",
          "object"
        ]
      }
    },
    "evidence_ceilings": {
      "type": "array",
      "items": {
        "type": [
          "string",
          "object"
        ]
      }
    },
    "stable_regions": {
      "type": "array",
      "items": {
        "type": [
          "string",
          "object"
        ]
      }
    },
    "uncertainty_frontiers": {
      "type": "array",
      "items": {
        "type": [
          "string",
          "object"
        ]
      }
    },
    "deformation_regions": {
      "type": "array",
      "items": {
        "type": [
          "string",
          "object"
        ]
      }
    },
    "invariant_anchors": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "return_routes": {
      "type": "array",
      "items": {
        "type": [
          "string",
          "object"
        ]
      }
    },
    "perspective_overlays": {
      "type": "array",
      "items": {
        "type": [
          "string",
          "object"
        ]
      }
    },
    "evolution_references": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "capability_position_references": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "collapse_boundary_references": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "passageway_references": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "propagation_vector_references": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
