{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "zervan://schemas/geography/stick_continuity_record.schema.json",
  "title": "Zervan R2-I Stick / Contact Continuity Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "stick_id",
    "object_id",
    "origin_reference",
    "ingress_envelope_reference",
    "cartography_reference",
    "source_orientation_reference",
    "target_orientation_reference",
    "transform_reference",
    "space_reference",
    "evidence_lineage_references",
    "provenance_route",
    "observation_references",
    "restriction_references",
    "source_coordinates",
    "target_coordinates",
    "return_coordinates",
    "continuity_state",
    "continuity_reason",
    "recorded_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "stick_id": {
      "type": "string",
      "pattern": "^sha512:[0-9a-f]{128}$"
    },
    "object_id": {
      "type": "string",
      "pattern": "^sha512:[0-9a-f]{128}$"
    },
    "origin_reference": {
      "type": "string",
      "minLength": 1
    },
    "ingress_envelope_reference": {
      "type": "string",
      "minLength": 1
    },
    "cartography_reference": {
      "type": "string",
      "minLength": 1
    },
    "source_orientation_reference": {
      "type": "string",
      "minLength": 1
    },
    "target_orientation_reference": {
      "type": "string",
      "minLength": 1
    },
    "transform_reference": {
      "type": [
        "string",
        "null"
      ]
    },
    "space_reference": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence_lineage_references": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "provenance_route": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "observation_references": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "restriction_references": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "source_coordinates": {
      "type": [
        "string",
        "object"
      ]
    },
    "target_coordinates": {
      "type": [
        "string",
        "object"
      ]
    },
    "return_coordinates": {
      "type": [
        "string",
        "object"
      ]
    },
    "continuity_state": {
      "type": "string",
      "enum": [
        "CONTINUOUS",
        "DEGRADED",
        "BROKEN"
      ]
    },
    "continuity_reason": {
      "type": "string",
      "minLength": 1
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
