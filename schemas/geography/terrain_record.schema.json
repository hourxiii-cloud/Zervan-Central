{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "zervan://schemas/geography/terrain_record.schema.json",
  "title": "Zervan R2-C Terrain Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "terrain_record_id",
    "object_id",
    "representation_reference",
    "observation_reference",
    "features",
    "accessibility_state",
    "provenance_route",
    "observed_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "terrain_record_id": {
      "type": "string",
      "pattern": "^sha512:[0-9a-f]{128}$"
    },
    "object_id": {
      "type": "string",
      "pattern": "^sha512:[0-9a-f]{128}$"
    },
    "representation_reference": {
      "type": [
        "string",
        "null"
      ]
    },
    "observation_reference": {
      "type": "string",
      "minLength": 1
    },
    "features": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_structure": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "records": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "relationships": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "density": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "absence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "fractures": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "signal_concentrations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "boundaries": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "gradients": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "discontinuities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reachable_surfaces": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unreachable_surfaces": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "stable_regions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "uncertainty_frontiers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "deformation_regions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "accessibility_state": {
      "type": "string",
      "enum": [
        "OBSERVED",
        "RESTRICTED",
        "UNAVAILABLE",
        "UNRESOLVED"
      ]
    },
    "provenance_route": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
