{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "zervan://schemas/qualification/hydration_request.schema.json",
  "title": "Zervan R3-I Hydration Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "hydration_request_id",
    "object_id",
    "active_question",
    "capability_mission_request_reference",
    "formation_selection_reference",
    "occupancy_witness_reference",
    "zone_reference",
    "space_reference",
    "orientation_reference",
    "territory_reference",
    "requested_verified_territory_references",
    "requested_payload_references",
    "payload_scope",
    "mission_necessity_basis",
    "evidence_boundary",
    "evidence_ceiling",
    "restriction_references",
    "stick_reference",
    "governance_reference",
    "authorization_reference",
    "human_gate_reference",
    "provenance_route",
    "requested_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "hydration_request_id": {
      "type": "string",
      "pattern": "^sha512:[0-9a-f]{128}$"
    },
    "object_id": {
      "type": "string",
      "pattern": "^sha512:[0-9a-f]{128}$"
    },
    "active_question": {
      "type": "string",
      "minLength": 1
    },
    "capability_mission_request_reference": {
      "type": "string",
      "minLength": 1
    },
    "formation_selection_reference": {
      "type": [
        "string",
        "null"
      ]
    },
    "occupancy_witness_reference": {
      "type": "string",
      "minLength": 1
    },
    "zone_reference": {
      "type": "string",
      "minLength": 1
    },
    "space_reference": {
      "type": "string",
      "minLength": 1
    },
    "orientation_reference": {
      "type": "string",
      "minLength": 1
    },
    "territory_reference": {
      "type": "string",
      "minLength": 1
    },
    "requested_verified_territory_references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "requested_payload_references": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "payload_scope": {
      "type": "string",
      "const": "MISSION_REQUIRED"
    },
    "mission_necessity_basis": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence_boundary": {
      "type": [
        "string",
        "object"
      ]
    },
    "evidence_ceiling": {
      "type": [
        "string",
        "object"
      ]
    },
    "restriction_references": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "stick_reference": {
      "type": "string",
      "minLength": 1
    },
    "governance_reference": {
      "type": "string",
      "minLength": 1
    },
    "authorization_reference": {
      "type": "string",
      "minLength": 1
    },
    "human_gate_reference": {
      "type": [
        "string",
        "null"
      ]
    },
    "provenance_route": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "requested_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
