{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "zervan://schemas/qualification/occupancy_witness.schema.json",
  "title": "Zervan R3-D Occupancy Witness",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "occupancy_witness_id",
    "object_id",
    "occupant_capability",
    "occupancy_event",
    "lifecycle_readiness_reference",
    "qualification_record_reference",
    "occupied_zone_id",
    "occupied_space_id",
    "orientation_reference",
    "cartography_reference",
    "stick_reference",
    "entry_authorization_reference",
    "governance_constraint_reference",
    "human_gate_reference",
    "evidence_boundary",
    "evidence_ceiling",
    "current_coordinates",
    "return_coordinates",
    "occupancy_basis",
    "provenance_route",
    "witnessed_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "occupancy_witness_id": {
      "type": "string",
      "pattern": "^sha512:[0-9a-f]{128}$"
    },
    "object_id": {
      "type": "string",
      "pattern": "^sha512:[0-9a-f]{128}$"
    },
    "occupant_capability": {
      "type": "string",
      "minLength": 1
    },
    "occupancy_event": {
      "type": "string",
      "enum": [
        "ENTERED",
        "PRESENT",
        "EXITED"
      ]
    },
    "lifecycle_readiness_reference": {
      "type": "string",
      "minLength": 1
    },
    "qualification_record_reference": {
      "type": "string",
      "minLength": 1
    },
    "occupied_zone_id": {
      "type": "string",
      "pattern": "^sha512:[0-9a-f]{128}$"
    },
    "occupied_space_id": {
      "type": "string",
      "pattern": "^sha512:[0-9a-f]{128}$"
    },
    "orientation_reference": {
      "type": "string",
      "minLength": 1
    },
    "cartography_reference": {
      "type": "string",
      "minLength": 1
    },
    "stick_reference": {
      "type": "string",
      "minLength": 1
    },
    "entry_authorization_reference": {
      "type": "string",
      "minLength": 1
    },
    "governance_constraint_reference": {
      "type": "string",
      "minLength": 1
    },
    "human_gate_reference": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence_boundary": {
      "type": [
        "string",
        "object"
      ]
    },
    "evidence_ceiling": {
      "type": [
        "string",
        "object"
      ]
    },
    "current_coordinates": {
      "type": [
        "string",
        "object"
      ]
    },
    "return_coordinates": {
      "type": [
        "string",
        "object"
      ]
    },
    "occupancy_basis": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "provenance_route": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "witnessed_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
