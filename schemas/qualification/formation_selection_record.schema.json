{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "zervan://schemas/qualification/formation_selection_record.schema.json",
  "title": "Zervan R3-G Formation Selection Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "formation_selection_id",
    "object_id",
    "formation_type",
    "capability_mission_request_references",
    "proportional_force_selection_references",
    "occupancy_witness_references",
    "active_questions",
    "selected_capability_references",
    "target_room_references",
    "zone_references",
    "space_references",
    "representation_coordinate_references",
    "evidence_boundary",
    "evidence_ceiling",
    "independent_finding_policy",
    "correlation_policy",
    "integration_basis",
    "rejustification_triggers",
    "stick_reference",
    "toc_reference",
    "governance_reference",
    "authorization_reference",
    "provenance_route",
    "selected_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "formation_selection_id": {
      "type": "string",
      "pattern": "^sha512:[0-9a-f]{128}$"
    },
    "object_id": {
      "type": "string",
      "pattern": "^sha512:[0-9a-f]{128}$"
    },
    "formation_type": {
      "type": "string",
      "enum": [
        "SINGLE_ROUTE",
        "STACK_ANALYSIS",
        "EXPANDED_ANALYSIS",
        "SWARM"
      ]
    },
    "capability_mission_request_references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "proportional_force_selection_references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "occupancy_witness_references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "active_questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "selected_capability_references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "target_room_references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "zone_references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "space_references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "representation_coordinate_references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence_boundary": {
      "type": [
        "string",
        "object"
      ]
    },
    "evidence_ceiling": {
      "type": [
        "string",
        "object"
      ]
    },
    "independent_finding_policy": {
      "type": "string",
      "minLength": 1
    },
    "correlation_policy": {
      "type": "string",
      "minLength": 1
    },
    "integration_basis": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "rejustification_triggers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "stick_reference": {
      "type": "string",
      "minLength": 1
    },
    "toc_reference": {
      "type": "string",
      "minLength": 1
    },
    "governance_reference": {
      "type": "string",
      "minLength": 1
    },
    "authorization_reference": {
      "type": [
        "string",
        "null"
      ]
    },
    "provenance_route": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "selected_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
