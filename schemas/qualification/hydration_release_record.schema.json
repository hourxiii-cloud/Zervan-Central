{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "zervan://schemas/qualification/hydration_release_record.schema.json",
  "title": "Zervan R3-I Hydration Release Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "hydration_release_id",
    "hydration_request_reference",
    "object_id",
    "release_state",
    "restored_verified_territory_references",
    "restored_payload_references",
    "denied_or_blocked_references",
    "retained_at_rest_references",
    "released_from_active_payload_references",
    "release_basis",
    "restriction_findings",
    "evidence_boundary",
    "evidence_ceiling",
    "room_state_reference",
    "representation_state_reference",
    "stick_reference",
    "final_active_payload_scope",
    "provenance_route",
    "released_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "hydration_release_id": {
      "type": "string",
      "pattern": "^sha512:[0-9a-f]{128}$"
    },
    "hydration_request_reference": {
      "type": "string",
      "minLength": 1
    },
    "object_id": {
      "type": "string",
      "pattern": "^sha512:[0-9a-f]{128}$"
    },
    "release_state": {
      "type": "string",
      "enum": [
        "RELEASED",
        "PARTIAL",
        "BLOCKED"
      ]
    },
    "restored_verified_territory_references": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "restored_payload_references": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "denied_or_blocked_references": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "retained_at_rest_references": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "released_from_active_payload_references": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "release_basis": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "restriction_findings": {
      "type": "array",
      "items": {
        "type": [
          "string",
          "object"
        ]
      }
    },
    "evidence_boundary": {
      "type": [
        "string",
        "object"
      ]
    },
    "evidence_ceiling": {
      "type": [
        "string",
        "object"
      ]
    },
    "room_state_reference": {
      "type": "string",
      "minLength": 1
    },
    "representation_state_reference": {
      "type": "string",
      "minLength": 1
    },
    "stick_reference": {
      "type": "string",
      "minLength": 1
    },
    "final_active_payload_scope": {
      "type": "string",
      "const": "MISSION_REQUIRED"
    },
    "provenance_route": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "released_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
