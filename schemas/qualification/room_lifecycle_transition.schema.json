{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "zervan://schemas/qualification/room_lifecycle_transition.schema.json",
  "title": "Zervan R3-C Room Lifecycle Transition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "lifecycle_transition_id",
    "object_id",
    "source_state",
    "target_state",
    "qualification_request_reference",
    "qualification_record_reference",
    "qualification_disposition",
    "declared_mission",
    "evidence_ceiling",
    "readiness_requirements",
    "unresolved_readiness_blockers",
    "transition_basis",
    "registry_reference",
    "audit_reference",
    "authorization_reference",
    "human_gate_reference",
    "provenance_route",
    "transitioned_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "lifecycle_transition_id": {
      "type": "string",
      "pattern": "^sha512:[0-9a-f]{128}$"
    },
    "object_id": {
      "type": "string",
      "pattern": "^sha512:[0-9a-f]{128}$"
    },
    "source_state": {
      "type": "string",
      "enum": [
        "DETECTED",
        "PROVISIONAL",
        "QUALIFYING",
        "QUALIFIED",
        "READY",
        "ACTIVE",
        "LANDED",
        "DEGRADED",
        "SEALED",
        "REOPENED",
        "REJECTED",
        "SUPERSEDED"
      ]
    },
    "target_state": {
      "type": "string",
      "enum": [
        "DETECTED",
        "PROVISIONAL",
        "QUALIFYING",
        "QUALIFIED",
        "READY",
        "ACTIVE",
        "LANDED",
        "DEGRADED",
        "SEALED",
        "REOPENED",
        "REJECTED",
        "SUPERSEDED"
      ]
    },
    "qualification_request_reference": {
      "type": [
        "string",
        "null"
      ]
    },
    "qualification_record_reference": {
      "type": [
        "string",
        "null"
      ]
    },
    "qualification_disposition": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "QUALIFIED",
        "PROVISIONAL",
        "REJECTED",
        "DEGRADED",
        null
      ]
    },
    "declared_mission": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence_ceiling": {
      "type": [
        "string",
        "object",
        "null"
      ]
    },
    "readiness_requirements": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "unresolved_readiness_blockers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "transition_basis": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "registry_reference": {
      "type": "string",
      "minLength": 1
    },
    "audit_reference": {
      "type": [
        "string",
        "null"
      ]
    },
    "authorization_reference": {
      "type": [
        "string",
        "null"
      ]
    },
    "human_gate_reference": {
      "type": [
        "string",
        "null"
      ]
    },
    "provenance_route": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "transitioned_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
