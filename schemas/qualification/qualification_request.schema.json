{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "zervan://schemas/qualification/qualification_request.schema.json",
  "title": "Zervan R3-A Qualification Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "qualification_request_id",
    "object_id",
    "provisional_room_reference",
    "origin_reference",
    "ingress_reference",
    "zone_id",
    "space_id",
    "orientation_reference",
    "territory_reference",
    "qualification_mission",
    "active_question",
    "entry_constraints",
    "evidence_obligations",
    "included_evidence",
    "excluded_evidence",
    "evidence_boundary",
    "evidence_ceiling",
    "prohibited_assumptions",
    "human_gate_conditions",
    "qualification_requirements",
    "request_state",
    "provenance_route",
    "requested_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "qualification_request_id": {
      "type": "string",
      "pattern": "^sha512:[0-9a-f]{128}$"
    },
    "object_id": {
      "type": "string",
      "pattern": "^sha512:[0-9a-f]{128}$"
    },
    "provisional_room_reference": {
      "type": "string",
      "minLength": 1
    },
    "origin_reference": {
      "type": "string",
      "minLength": 1
    },
    "ingress_reference": {
      "type": "string",
      "minLength": 1
    },
    "zone_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^sha512:[0-9a-f]{128}$"
    },
    "space_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^sha512:[0-9a-f]{128}$"
    },
    "orientation_reference": {
      "type": "string",
      "minLength": 1
    },
    "territory_reference": {
      "type": "string",
      "minLength": 1
    },
    "qualification_mission": {
      "type": "string",
      "minLength": 1
    },
    "active_question": {
      "type": "string",
      "minLength": 1
    },
    "entry_constraints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence_obligations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "included_evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "excluded_evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence_boundary": {
      "type": [
        "string",
        "object"
      ]
    },
    "evidence_ceiling": {
      "type": [
        "string",
        "object"
      ]
    },
    "prohibited_assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "human_gate_conditions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "qualification_requirements": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "request_state": {
      "type": "string",
      "enum": [
        "DRAFT",
        "READY",
        "BLOCKED"
      ]
    },
    "provenance_route": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "requested_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
