{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "zervan://schemas/authority/authority_transition_binding.schema.json",
  "title": "Zervan AC-06 Authority-Bearing Transition Binding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "authorization_binding_id",
    "human_gate_decision_id",
    "decision_state",
    "transition_class",
    "transition_target",
    "object_id",
    "room_revision_id",
    "room_state_root",
    "authorized_view_root",
    "evidence_boundary_reference",
    "evidence_ceiling_reference",
    "approved_scope",
    "mc_disposition",
    "conditional_requirement_references",
    "condition_satisfaction_references",
    "execution_cardinality",
    "maximum_execution_count",
    "successful_execution_count",
    "consumption_state",
    "invalidation_reasons",
    "provenance_route",
    "authority_state",
    "human_gate_state"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "authorization_binding_id": {
      "type": "string",
      "pattern": "^sha512:[0-9a-f]{128}$"
    },
    "human_gate_decision_id": {
      "type": "string",
      "minLength": 1
    },
    "decision_state": {
      "type": "string",
      "enum": [
        "PENDING",
        "APPROVED",
        "DENIED"
      ]
    },
    "transition_class": {
      "type": "string",
      "minLength": 1
    },
    "transition_target": {
      "type": "string",
      "minLength": 1
    },
    "object_id": {
      "type": "string",
      "minLength": 1
    },
    "room_revision_id": {
      "type": "string",
      "minLength": 1
    },
    "room_state_root": {
      "type": "string",
      "minLength": 1
    },
    "authorized_view_root": {
      "type": "string",
      "minLength": 1
    },
    "evidence_boundary_reference": {
      "type": "string",
      "minLength": 1
    },
    "evidence_ceiling_reference": {
      "type": "string",
      "minLength": 1
    },
    "approved_scope": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "mc_disposition": {
      "type": "string",
      "enum": [
        "ADMISSIBLE",
        "CONDITIONAL",
        "INADMISSIBLE"
      ]
    },
    "conditional_requirement_references": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "condition_satisfaction_references": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "execution_cardinality": {
      "type": "string",
      "enum": [
        "SINGLE",
        "BOUNDED_REPEAT"
      ]
    },
    "maximum_execution_count": {
      "type": "integer",
      "minimum": 1
    },
    "successful_execution_count": {
      "type": "integer",
      "minimum": 0
    },
    "consumption_state": {
      "type": "string",
      "enum": [
        "UNUSED",
        "PARTIALLY_CONSUMED",
        "CONSUMED",
        "INVALIDATED"
      ]
    },
    "invalidation_reasons": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "provenance_route": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "authority_state": {
      "type": "string",
      "const": "NONE"
    },
    "human_gate_state": {
      "type": "string",
      "const": "ACTIVE"
    }
  }
}
