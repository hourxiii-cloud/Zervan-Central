{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "zervan://schemas/promotion/ring7_documentation_promotion_registry.schema.json",
  "title": "Zervan R7-A Documentation Promotion Registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "ring",
    "domain",
    "native_version",
    "implementation_identity",
    "inherited_state",
    "sections",
    "documentation_ownership",
    "required_machine_surfaces",
    "surface_states",
    "promotion_blockers",
    "authority_state",
    "human_gate_state",
    "promotion_state",
    "target_state",
    "registry_disposition",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "ring": {
      "type": "string",
      "const": "R7-A"
    },
    "domain": {
      "type": "string",
      "const": "DOCUMENTATION_AND_PROMOTION"
    },
    "native_version": {
      "type": "string",
      "const": "vTemporal.41.0"
    },
    "implementation_identity": {
      "type": "string",
      "const": "v41 Complete"
    },
    "inherited_state": {
      "type": "string",
      "const": "R6-P VALIDATED_CANDIDATE"
    },
    "sections": {
      "type": "object",
      "minProperties": 14
    },
    "documentation_ownership": {
      "type": "object"
    },
    "required_machine_surfaces": {
      "type": "array",
      "uniqueItems": true
    },
    "surface_states": {
      "type": "object"
    },
    "promotion_blockers": {
      "type": "array",
      "uniqueItems": true
    },
    "authority_state": {
      "type": "string",
      "const": "NONE"
    },
    "human_gate_state": {
      "type": "string",
      "const": "ACTIVE"
    },
    "promotion_state": {
      "type": "string",
      "const": "CANDIDATE"
    },
    "target_state": {
      "type": "string",
      "const": "READY_FOR_HUMAN_GATE"
    },
    "registry_disposition": {
      "type": "string",
      "enum": [
        "VALIDATED",
        "BLOCKED"
      ]
    },
    "provenance": {
      "type": "array",
      "minItems": 1
    }
  }
}
