{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "zervan://schemas/promotion/human_gate_authorization_receipt.schema.json",
  "title": "Zervan Human Gate Authorization Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "ring",
    "native_version",
    "implementation_identity",
    "candidate_branch",
    "candidate_commit",
    "candidate_tree",
    "target_branch",
    "binding_sha512",
    "decision",
    "authorization_state",
    "decision_actor",
    "decision_timestamp",
    "decision_scope",
    "rationale",
    "provenance",
    "authority_state",
    "human_gate_state",
    "promotion_state",
    "promotion_executed",
    "canonical",
    "promoted",
    "merged"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "record_type": {
      "const": "HUMAN_GATE_AUTHORIZATION_RECEIPT"
    },
    "ring": {
      "const": "R8-E"
    },
    "native_version": {
      "const": "vTemporal.41.0"
    },
    "implementation_identity": {
      "const": "v41 Complete"
    },
    "candidate_branch": {
      "const": "candidate/v41-complete"
    },
    "candidate_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "candidate_tree": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "target_branch": {
      "const": "main"
    },
    "binding_sha512": {
      "type": "string",
      "pattern": "^[0-9a-f]{128}$"
    },
    "decision": {
      "enum": [
        "APPROVE",
        "REJECT",
        "DEFER"
      ]
    },
    "authorization_state": {
      "enum": [
        "GRANTED",
        "DENIED",
        "DEFERRED"
      ]
    },
    "decision_actor": {
      "type": "string",
      "minLength": 1
    },
    "decision_timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "decision_scope": {
      "type": "string",
      "minLength": 1
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "authority_state": {
      "const": "NONE"
    },
    "human_gate_state": {
      "const": "ACTIVE"
    },
    "promotion_state": {
      "const": "CANDIDATE"
    },
    "promotion_executed": {
      "const": false
    },
    "canonical": {
      "const": false
    },
    "promoted": {
      "const": false
    },
    "merged": {
      "const": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "decision": {
            "const": "APPROVE"
          }
        },
        "required": [
          "decision"
        ]
      },
      "then": {
        "properties": {
          "authorization_state": {
            "const": "GRANTED"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision": {
            "const": "REJECT"
          }
        },
        "required": [
          "decision"
        ]
      },
      "then": {
        "properties": {
          "authorization_state": {
            "const": "DENIED"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision": {
            "const": "DEFER"
          }
        },
        "required": [
          "decision"
        ]
      },
      "then": {
        "properties": {
          "authorization_state": {
            "const": "DEFERRED"
          }
        }
      }
    }
  ]
}
