{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "zervan://schemas/promotion/completeness_receipt.schema.json",
  "title": "Zervan R7-K Completeness Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_type",
    "ring",
    "native_version",
    "implementation_identity",
    "stability_baseline",
    "documentation",
    "machine_readable_surfaces",
    "remaining_sections",
    "promotion_blockers",
    "authority_state",
    "human_gate_state",
    "promotion_state",
    "promotion_ready",
    "canonical",
    "disposition",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "receipt_type": {
      "const": "COMPLETENESS_RECEIPT"
    },
    "ring": {
      "const": "R7-K"
    },
    "native_version": {
      "const": "vTemporal.41.0"
    },
    "implementation_identity": {
      "const": "v41 Complete"
    },
    "stability_baseline": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "documentation": {
      "type": "object"
    },
    "machine_readable_surfaces": {
      "type": "object"
    },
    "remaining_sections": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "string"
      }
    },
    "promotion_blockers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "authority_state": {
      "const": "NONE"
    },
    "human_gate_state": {
      "const": "ACTIVE"
    },
    "promotion_state": {
      "const": "CANDIDATE"
    },
    "promotion_ready": {
      "const": false
    },
    "canonical": {
      "const": false
    },
    "disposition": {
      "const": "COMPLETENESS_VALIDATED"
    },
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  }
}
