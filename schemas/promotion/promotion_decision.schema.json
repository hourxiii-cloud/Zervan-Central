{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "zervan://schemas/promotion/promotion_decision.schema.json",
  "title": "Zervan Promotion Decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "ring",
    "native_version",
    "implementation_identity",
    "candidate_branch",
    "candidate_commit",
    "target_branch",
    "decision",
    "decision_scope",
    "decision_actor",
    "decision_timestamp",
    "rationale",
    "provenance",
    "authority_state",
    "human_gate_state"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "record_type": {
      "const": "PROMOTION_DECISION"
    },
    "ring": {
      "const": "R8-B"
    },
    "native_version": {
      "const": "vTemporal.41.0"
    },
    "implementation_identity": {
      "const": "v41 Complete"
    },
    "candidate_branch": {
      "const": "candidate/v41-complete"
    },
    "candidate_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "target_branch": {
      "const": "main"
    },
    "decision": {
      "enum": [
        "APPROVE",
        "REJECT",
        "DEFER"
      ]
    },
    "decision_scope": {
      "type": "string",
      "minLength": 1
    },
    "decision_actor": {
      "type": "string",
      "minLength": 1
    },
    "decision_timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "authority_state": {
      "const": "NONE"
    },
    "human_gate_state": {
      "const": "ACTIVE"
    }
  }
}
