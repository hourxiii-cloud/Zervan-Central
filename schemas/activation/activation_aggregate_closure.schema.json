{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "zervan://schemas/activation/activation_aggregate_closure.schema.json",
  "title": "Zervan AC-12 Activation Aggregate Closure",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "activation_control",
    "required_controls",
    "control_results",
    "required_control_count",
    "passed_control_count",
    "failed_control_count",
    "blocked_control_count",
    "evidence_ceiling_state",
    "human_gate_semantic_state",
    "cross_control_integrity_state",
    "authority_state",
    "human_gate_state",
    "execution_state",
    "publication_state",
    "canonical_mutation_state",
    "system_population_state",
    "provenance_route",
    "closure_disposition",
    "failure_reasons"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "activation_control": {
      "type": "string",
      "const": "AC-12"
    },
    "required_controls": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "uniqueItems": true,
      "prefixItems": [
        { "const": "AC-01" },
        { "const": "AC-02" },
        { "const": "AC-03" },
        { "const": "AC-04" },
        { "const": "AC-05" },
        { "const": "AC-06" },
        { "const": "AC-07" },
        { "const": "AC-08" },
        { "const": "AC-09" },
        { "const": "AC-10" },
        { "const": "AC-11" }
      ],
      "items": false
    },
    "control_results": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "items": {
        "$ref": "#/$defs/control_result"
      }
    },
    "required_control_count": {
      "type": "integer",
      "const": 11
    },
    "passed_control_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 11
    },
    "failed_control_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 11
    },
    "blocked_control_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 11
    },
    "evidence_ceiling_state": {
      "type": "string",
      "enum": [
        "ENFORCED",
        "MISSING",
        "FAILED",
        "UNKNOWN"
      ]
    },
    "human_gate_semantic_state": {
      "type": "string",
      "enum": [
        "ENFORCED",
        "MISSING",
        "FAILED",
        "UNKNOWN"
      ]
    },
    "cross_control_integrity_state": {
      "type": "string",
      "enum": [
        "VALID",
        "BLOCKED",
        "UNKNOWN"
      ]
    },
    "authority_state": {
      "type": "string",
      "const": "NONE"
    },
    "human_gate_state": {
      "type": "string",
      "const": "ACTIVE"
    },
    "execution_state": {
      "type": "string",
      "const": "NOT_INFERRED"
    },
    "publication_state": {
      "type": "string",
      "const": "NOT_INFERRED"
    },
    "canonical_mutation_state": {
      "type": "string",
      "const": "NOT_INFERRED"
    },
    "system_population_state": {
      "type": "string",
      "const": "DISALLOWED"
    },
    "provenance_route": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "closure_disposition": {
      "type": "string",
      "enum": [
        "CLOSED",
        "BLOCKED"
      ]
    },
    "failure_reasons": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "REQUIRED_CONTROL_MISSING",
          "REQUIRED_CONTROL_FAILED",
          "REQUIRED_CONTROL_BLOCKED",
          "CONTROL_RESULT_UNKNOWN",
          "CROSS_CONTROL_SEMANTIC_CONFLICT",
          "EVIDENCE_CEILING_ENFORCEMENT_MISSING",
          "HUMAN_GATE_ENFORCEMENT_MISSING",
          "AUTHORITY_PROMOTED",
          "HUMAN_GATE_DISABLED",
          "EXECUTION_INFERRED",
          "PUBLICATION_INFERRED",
          "CANONICAL_MUTATION_INFERRED",
          "SYSTEM_POPULATION_INFERRED",
          "PROVENANCE_MISSING",
          "FAILURE_COMPRESSED_OUT"
        ]
      }
    }
  },
  "$defs": {
    "control_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "control_id",
        "validation_state",
        "validator_reference",
        "test_reference",
        "provenance_reference"
      ],
      "properties": {
        "control_id": {
          "type": "string",
          "enum": [
            "AC-01",
            "AC-02",
            "AC-03",
            "AC-04",
            "AC-05",
            "AC-06",
            "AC-07",
            "AC-08",
            "AC-09",
            "AC-10",
            "AC-11"
          ]
        },
        "validation_state": {
          "type": "string",
          "enum": [
            "PASS",
            "FAIL",
            "BLOCKED",
            "UNKNOWN"
          ]
        },
        "validator_reference": {
          "type": "string",
          "minLength": 1
        },
        "test_reference": {
          "type": "string",
          "minLength": 1
        },
        "provenance_reference": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
