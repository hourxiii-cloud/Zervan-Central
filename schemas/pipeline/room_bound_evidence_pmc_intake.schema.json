{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "zervan://schemas/pipeline/room_bound_evidence_pmc_intake.schema.json",
  "title": "Zervan R5-B Room-Bound Evidence PMC Intake",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "intake_binding_id",
    "object_id",
    "room_revision_id",
    "room_state_root",
    "authorized_view_root",
    "evidence_references",
    "evidence_integrity_references",
    "evidence_classes",
    "evidence_boundary_reference",
    "evidence_ceiling_reference",
    "coordinate_reference",
    "representation_reference",
    "transform_references",
    "lineage_reference",
    "unresolved_state_references",
    "qualification_reference",
    "deterministic_parameter_references",
    "provenance_route",
    "intake_disposition",
    "blocking_reasons",
    "authority_state",
    "human_gate_state",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "intake_binding_id": {
      "type": "string",
      "pattern": "^sha512:[0-9a-f]{128}$"
    },
    "object_id": {
      "type": "string",
      "pattern": "^sha512:[0-9a-f]{128}$"
    },
    "room_revision_id": {
      "type": "string",
      "minLength": 1
    },
    "room_state_root": {
      "type": "string",
      "pattern": "^sha512:[0-9a-f]{128}$"
    },
    "authorized_view_root": {
      "type": "string",
      "pattern": "^sha512:[0-9a-f]{128}$"
    },
    "evidence_references": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence_integrity_references": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence_classes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "STRUCTURAL",
          "INTERPRETIVE"
        ]
      }
    },
    "evidence_boundary_reference": {
      "type": "string",
      "minLength": 1
    },
    "evidence_ceiling_reference": {
      "type": "string",
      "minLength": 1
    },
    "coordinate_reference": {
      "type": "string",
      "minLength": 1
    },
    "representation_reference": {
      "type": "string",
      "minLength": 1
    },
    "transform_references": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "lineage_reference": {
      "type": "string",
      "minLength": 1
    },
    "unresolved_state_references": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "qualification_reference": {
      "type": "string",
      "minLength": 1
    },
    "deterministic_parameter_references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "provenance_route": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "intake_disposition": {
      "type": "string",
      "enum": [
        "ADMISSIBLE",
        "BLOCKED"
      ]
    },
    "blocking_reasons": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "authority_state": {
      "type": "string",
      "const": "NONE"
    },
    "human_gate_state": {
      "type": "string",
      "const": "ACTIVE"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
