{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "zervan://schemas/pipeline/raven_representation_binding.schema.json",
  "title": "Zervan R5-E Raven Representation Binding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "raven_representation_id",
    "mc_evaluation_id",
    "ccr_id",
    "object_id",
    "room_revision_id",
    "room_state_root",
    "authorized_view_root",
    "evidence_boundary_reference",
    "evidence_ceiling_reference",
    "coordinate_reference",
    "upstream_representation_reference",
    "raven_transform_references",
    "findings",
    "unknowns",
    "mc_response_class_results",
    "trace_map",
    "lineage_reference",
    "provenance_route",
    "raven_status",
    "unkindness_disposition",
    "authority_state",
    "human_gate_state"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "raven_representation_id": {
      "type": "string",
      "pattern": "^sha512:[0-9a-f]{128}$"
    },
    "mc_evaluation_id": {
      "type": "string",
      "pattern": "^sha512:[0-9a-f]{128}$"
    },
    "ccr_id": {
      "type": "string",
      "pattern": "^sha512:[0-9a-f]{128}$"
    },
    "object_id": {
      "type": "string",
      "pattern": "^sha512:[0-9a-f]{128}$"
    },
    "room_revision_id": {
      "type": "string",
      "minLength": 1
    },
    "room_state_root": {
      "type": "string",
      "pattern": "^sha512:[0-9a-f]{128}$"
    },
    "authorized_view_root": {
      "type": "string",
      "pattern": "^sha512:[0-9a-f]{128}$"
    },
    "evidence_boundary_reference": {
      "type": "string",
      "minLength": 1
    },
    "evidence_ceiling_reference": {
      "type": "string",
      "minLength": 1
    },
    "coordinate_reference": {
      "type": "string",
      "minLength": 1
    },
    "upstream_representation_reference": {
      "type": "string",
      "minLength": 1
    },
    "raven_transform_references": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "finding_id",
          "classification",
          "text"
        ],
        "properties": {
          "finding_id": {
            "type": "string",
            "minLength": 1
          },
          "classification": {
            "type": "string",
            "enum": [
              "OBSERVED",
              "INFERRED",
              "UNKNOWN"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "mc_response_class_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "response_class",
          "disposition",
          "required_conditions",
          "inadmissibility_reasons"
        ],
        "properties": {
          "response_class": {
            "type": "string",
            "minLength": 1
          },
          "disposition": {
            "type": "string",
            "enum": [
              "ADMISSIBLE",
              "CONDITIONAL",
              "INADMISSIBLE"
            ]
          },
          "required_conditions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "inadmissibility_reasons": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "trace_map": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim_reference",
          "source_references"
        ],
        "properties": {
          "claim_reference": {
            "type": "string",
            "minLength": 1
          },
          "source_references": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "lineage_reference": {
      "type": "string",
      "minLength": 1
    },
    "provenance_route": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "raven_status": {
      "type": "string",
      "enum": [
        "OK",
        "DEGRADED",
        "FAILED_INTEGRITY",
        "FAILED_SCHEMA",
        "FAILED_TRACEABILITY",
        "FAILED_MC_ADMISSIBILITY",
        "INSUFFICIENT_EVIDENCE"
      ]
    },
    "unkindness_disposition": {
      "type": "string",
      "const": "RAVEN_ASSOCIATED_FORWARD_TRANSLATION"
    },
    "authority_state": {
      "type": "string",
      "const": "NONE"
    },
    "human_gate_state": {
      "type": "string",
      "const": "ACTIVE"
    }
  }
}
