{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "zervan://schemas/analysis/evidence_ceiling.schema.json",
  "title": "Zervan Evidence-Ceiling Evaluation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "claim_id",
    "claim_text",
    "epistemic_class",
    "available_evidence_scope",
    "required_evidence_scope",
    "evidence_boundary_reference",
    "evidence_ceiling_reference",
    "evidence_references",
    "missing_evidence_requirements",
    "collision_disposition",
    "confidence",
    "claim_disposition",
    "provenance_route",
    "authority_state",
    "human_gate_state"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "claim_id": {
      "type": "string",
      "minLength": 1
    },
    "claim_text": {
      "type": "string",
      "minLength": 1
    },
    "epistemic_class": {
      "type": "string",
      "enum": [
        "OBSERVED",
        "INFERRED",
        "UNKNOWN"
      ]
    },
    "available_evidence_scope": {
      "type": "string",
      "enum": [
        "ROW_LOCAL",
        "GROUP_LOCAL",
        "EVENT_CONTEXT",
        "NATIVE_CONTEXT"
      ]
    },
    "required_evidence_scope": {
      "type": "string",
      "enum": [
        "ROW_LOCAL",
        "GROUP_LOCAL",
        "EVENT_CONTEXT",
        "NATIVE_CONTEXT"
      ]
    },
    "evidence_boundary_reference": {
      "type": "string",
      "minLength": 1
    },
    "evidence_ceiling_reference": {
      "type": "string",
      "minLength": 1
    },
    "evidence_references": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "missing_evidence_requirements": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "collision_disposition": {
      "type": "string",
      "enum": [
        "CLEAN",
        "COLLISION",
        "UNRESOLVED_CONTEXT"
      ]
    },
    "confidence": {
      "type": ["number", "null"],
      "minimum": 0.0,
      "maximum": 1.0
    },
    "claim_disposition": {
      "type": "string",
      "enum": [
        "ADMISSIBLE",
        "CONDITIONAL",
        "INADMISSIBLE",
        "UNRESOLVED"
      ]
    },
    "provenance_route": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "authority_state": {
      "type": "string",
      "const": "NONE"
    },
    "human_gate_state": {
      "type": "string",
      "const": "ACTIVE"
    }
  }
}
