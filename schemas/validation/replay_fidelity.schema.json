{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "zervan://schemas/validation/replay_fidelity.schema.json",
  "title": "Zervan R6-I Replay Fidelity",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "validation_vector",
    "historical_object_id",
    "replay_object_id",
    "closing_witness_reference",
    "historical_lineage_reference",
    "replay_lineage_reference",
    "historical_question_reference",
    "replay_question_reference",
    "historical_inquiry_envelope_reference",
    "replay_inquiry_envelope_reference",
    "historical_departure_coordinate",
    "historical_observational_coordinate",
    "replay_observational_coordinate",
    "historical_zone_reference",
    "replay_zone_reference",
    "historical_space_reference",
    "replay_space_reference",
    "historical_transform_references",
    "replay_transform_references",
    "historical_evidence_used_references",
    "replay_evidence_used_references",
    "historical_capability_movement_references",
    "replay_capability_movement_references",
    "historical_evidence_boundary_reference",
    "replay_evidence_boundary_reference",
    "historical_evidence_ceiling_reference",
    "replay_evidence_ceiling_reference",
    "historical_restriction_references",
    "replay_restriction_references",
    "historical_collapse_references",
    "replay_collapse_references",
    "historical_finding_references",
    "replay_finding_references",
    "historical_rendering_reference",
    "replay_rendering_reference",
    "historical_return_coordinate",
    "replay_return_coordinate",
    "historical_cartography_reference",
    "replay_cartography_reference",
    "historical_stick_reference",
    "replay_stick_reference",
    "approximate_reconstruction_used",
    "new_room_created",
    "branch_created",
    "lifecycle_mutated",
    "reflight_executed",
    "full_payload_hydration_requested",
    "replay_eligibility",
    "provenance_route",
    "authority_state",
    "human_gate_state",
    "validation_disposition",
    "failure_reasons"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "validation_vector": {
      "type": "string",
      "const": "REPLAY_FIDELITY"
    },
    "historical_object_id": {
      "type": "string",
      "pattern": "^sha512:[0-9a-f]{128}$"
    },
    "replay_object_id": {
      "type": "string",
      "pattern": "^sha512:[0-9a-f]{128}$"
    },
    "closing_witness_reference": {
      "type": [
        "string",
        "null"
      ]
    },
    "historical_lineage_reference": {
      "type": "string",
      "minLength": 1
    },
    "replay_lineage_reference": {
      "type": "string",
      "minLength": 1
    },
    "historical_question_reference": {
      "type": "string",
      "minLength": 1
    },
    "replay_question_reference": {
      "type": "string",
      "minLength": 1
    },
    "historical_inquiry_envelope_reference": {
      "type": "string",
      "minLength": 1
    },
    "replay_inquiry_envelope_reference": {
      "type": "string",
      "minLength": 1
    },
    "historical_departure_coordinate": {
      "type": "string",
      "minLength": 1
    },
    "historical_observational_coordinate": {
      "type": "string",
      "minLength": 1
    },
    "replay_observational_coordinate": {
      "type": "string",
      "minLength": 1
    },
    "historical_zone_reference": {
      "type": "string",
      "minLength": 1
    },
    "replay_zone_reference": {
      "type": "string",
      "minLength": 1
    },
    "historical_space_reference": {
      "type": "string",
      "minLength": 1
    },
    "replay_space_reference": {
      "type": "string",
      "minLength": 1
    },
    "historical_transform_references": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "replay_transform_references": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "historical_evidence_used_references": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "replay_evidence_used_references": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "historical_capability_movement_references": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "replay_capability_movement_references": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "historical_evidence_boundary_reference": {
      "type": "string",
      "minLength": 1
    },
    "replay_evidence_boundary_reference": {
      "type": "string",
      "minLength": 1
    },
    "historical_evidence_ceiling_reference": {
      "type": "string",
      "minLength": 1
    },
    "replay_evidence_ceiling_reference": {
      "type": "string",
      "minLength": 1
    },
    "historical_restriction_references": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "replay_restriction_references": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "historical_collapse_references": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "replay_collapse_references": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "historical_finding_references": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "replay_finding_references": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "historical_rendering_reference": {
      "type": [
        "string",
        "null"
      ]
    },
    "replay_rendering_reference": {
      "type": [
        "string",
        "null"
      ]
    },
    "historical_return_coordinate": {
      "type": "string",
      "minLength": 1
    },
    "replay_return_coordinate": {
      "type": "string",
      "minLength": 1
    },
    "historical_cartography_reference": {
      "type": "string",
      "minLength": 1
    },
    "replay_cartography_reference": {
      "type": "string",
      "minLength": 1
    },
    "historical_stick_reference": {
      "type": "string",
      "minLength": 1
    },
    "replay_stick_reference": {
      "type": "string",
      "minLength": 1
    },
    "approximate_reconstruction_used": {
      "type": "boolean"
    },
    "new_room_created": {
      "type": "boolean"
    },
    "branch_created": {
      "type": "boolean"
    },
    "lifecycle_mutated": {
      "type": "boolean"
    },
    "reflight_executed": {
      "type": "boolean"
    },
    "full_payload_hydration_requested": {
      "type": "boolean"
    },
    "replay_eligibility": {
      "type": "string",
      "enum": [
        "ELIGIBLE",
        "BLOCKED"
      ]
    },
    "provenance_route": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "authority_state": {
      "type": "string",
      "const": "NONE"
    },
    "human_gate_state": {
      "type": "string",
      "const": "ACTIVE"
    },
    "validation_disposition": {
      "type": "string",
      "enum": [
        "VALID",
        "BLOCKED"
      ]
    },
    "failure_reasons": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "OBJECT_IDENTITY_CHANGED",
          "CLOSING_WITNESS_MISSING",
          "LINEAGE_CHANGED",
          "HISTORICAL_QUESTION_SUBSTITUTED",
          "INQUIRY_ENVELOPE_SUBSTITUTED",
          "OBSERVATIONAL_COORDINATE_CHANGED",
          "ZONE_SUBSTITUTED",
          "SPACE_SUBSTITUTED",
          "TRANSFORM_HISTORY_CHANGED",
          "EVIDENCE_USED_CHANGED",
          "CAPABILITY_MOVEMENT_CHANGED",
          "EVIDENCE_BOUNDARY_CHANGED",
          "EVIDENCE_CEILING_CHANGED",
          "RESTRICTION_HISTORY_CHANGED",
          "COLLAPSE_HISTORY_CHANGED",
          "FINDING_HISTORY_CHANGED",
          "HISTORICAL_RENDERING_SUBSTITUTED",
          "RETURN_COORDINATE_CHANGED",
          "CARTOGRAPHY_CHANGED",
          "STICK_CHANGED",
          "APPROXIMATE_RECONSTRUCTION_USED",
          "NEW_ROOM_INVENTED",
          "BRANCH_INVENTED",
          "LIFECYCLE_MUTATED",
          "REFLIGHT_EXECUTED",
          "FULL_PAYLOAD_HYDRATION_REQUESTED",
          "AUTHORITY_PROMOTED"
        ]
      }
    }
  }
}
