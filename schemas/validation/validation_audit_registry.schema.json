{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "zervan://schemas/validation/validation_audit_registry.schema.json",
  "title": "Zervan R6-A Validation Audit Registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "native_version",
    "implementation_identity",
    "ring",
    "source_tranche",
    "ring5_dependency",
    "required_validation_families",
    "named_validation_vectors",
    "required_contract_audit_surfaces",
    "failure_classes",
    "registry_disposition",
    "promotion_state",
    "authority_state",
    "human_gate_state",
    "lineage_reference",
    "provenance_route"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "native_version": {
      "type": "string",
      "const": "vTemporal.41.0"
    },
    "implementation_identity": {
      "type": "string",
      "const": "v41 Complete"
    },
    "ring": {
      "type": "string",
      "const": "R6-A"
    },
    "source_tranche": {
      "type": "string",
      "const": "TRANCHE_8_VALIDATION_AND_AUDIT"
    },
    "ring5_dependency": {
      "type": "string",
      "const": "R5-J"
    },
    "required_validation_families": {
      "type": "array",
      "const": [
        "UNIT",
        "SCHEMA",
        "LIFECYCLE",
        "PERSPECTIVE_ROTATION",
        "ONE_OBJECT_CONVERGENCE",
        "DISTINCT_OBJECT",
        "PERTURBATION",
        "ORTHOGONAL_TRANSITION",
        "REPLAY",
        "REPLACEMENT",
        "REPRESENTATION_INDEPENDENCE",
        "LOSSLESS_COLLAPSE"
      ]
    },
    "named_validation_vectors": {
      "type": "array",
      "const": [
        "ONE_OBJECT_PERSPECTIVE_ROTATION",
        "PREMATURE_ANALYSIS_REJECTION",
        "PROPORTIONAL_FORCE_ROUTING",
        "QUALIFICATION_TEAM_COHERENCE",
        "FORMATION_REJUSTIFICATION",
        "DISTINCT_OBJECT_TEST",
        "HYDRATION_ON_NEED",
        "REPLAY_FIDELITY",
        "PMC_CCR_MC_COMPATIBILITY",
        "ORTHOGONAL_TRANSITION",
        "RBT_001",
        "FRESH_READER_TEST"
      ]
    },
    "required_contract_audit_surfaces": {
      "type": "array",
      "const": [
        "QUESTION_CONTRACT",
        "PROMOTION_RECEIPT",
        "LOSSLESS_COLLAPSE_RECEIPT"
      ]
    },
    "failure_classes": {
      "type": "array",
      "const": [
        "INNER_INVARIANT_CONTRADICTION",
        "OUTER_IMPLEMENTATION_DEFECT",
        "VALIDATOR_DEFECT",
        "COVERAGE_GAP",
        "SOURCE_COLLISION",
        "UNRESOLVED_REQUIRED_SURFACE"
      ]
    },
    "registry_disposition": {
      "type": "string",
      "enum": [
        "REGISTERED",
        "BLOCKED"
      ]
    },
    "promotion_state": {
      "type": "string",
      "const": "CANDIDATE"
    },
    "authority_state": {
      "type": "string",
      "const": "NONE"
    },
    "human_gate_state": {
      "type": "string",
      "const": "ACTIVE"
    },
    "lineage_reference": {
      "type": "string",
      "minLength": 1
    },
    "provenance_route": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
